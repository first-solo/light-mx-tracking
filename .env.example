# Random string, at least 32 characters. Generate one with:
#   docker run --rm node:22-slim node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First aircraft, created only when the database has no aircraft yet.
# Remove these after the first start; manage PINs with the admin commands.
INIT_TAIL=N7375Y
INIT_MODEL=PA-30
INIT_ENGINES=2
INIT_AD_79_12_08=true
INIT_VOR=true
INIT_PIN=

# How long a device stays unlocked after entering the PIN.
SESSION_DAYS=30

# Behind a reverse proxy that terminates HTTPS (Caddy, nginx, Cloudflare Tunnel), keep this at 1
# so secure cookies and the PIN rate limit see the real client.
TRUST_PROXY=1

# Set to false only for local testing over plain http.
COOKIE_SECURE=true

HOST_PORT=3000
